# Panick Monsta — environment variables
#
# Milestone 1 uses no backend and NO credentials. Every value below is a
# placeholder for Milestone 2, when the project connects to the owner's own
# Supabase project. Never put real secrets here — secrets belong in the
# server-side secret store only.

# --- Placeholder names only; do not fill in until Milestone 2 ---
VITE_SUPABASE_URL=REPLACE_WITH_YOUR_OWN_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_OWN_SUPABASE_ANON_KEY

# Public platform configuration (no secrets)
VITE_PLATFORM_NAME="Panick Monsta"
VITE_DEFAULT_CURRENCY=IDR
VITE_VIDEO_PROVIDER=placeholder
VITE_PAYMENT_PROVIDER=placeholder
